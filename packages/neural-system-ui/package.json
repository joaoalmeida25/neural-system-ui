{
  "name": "neural-system-ui",
  "version": "0.0.0",
  "private": true,
  "description": "React library for interactive 3D visualization of system architecture, flows, components, and operational execution.",
  "keywords": [
    "react",
    "three",
    "threejs",
    "react-three-fiber",
    "3d",
    "visualization",
    "system-visualization",
    "architecture",
    "observability",
    "runtime"
  ],
  "homepage": "https://github.com/joaoalmeida25/neural-system-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaoalmeida25/neural-system-ui.git"
  },
  "bugs": {
    "url": "https://github.com/joaoalmeida25/neural-system-ui/issues"
  },
  "author": "João Almeida",
  "type": "module",
  "types": "./dist/types/api/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\""
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.1.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@types/react": "19.3.0",
    "@types/three": "0.184.0",
    "react": "19.1.0",
    "three": "0.184.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "exports": {
    ".": {
      "types": "./dist/types/api/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/neural-system-ui.css"
  }
}
